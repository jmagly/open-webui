# SnowCrash deployment-managed configuration. Secret values are supplied separately.
# ENABLE_PERSISTENT_CONFIG=false makes these values effective on existing databases.
WEBUI_NAME=SnowCrash
WEBUI_URL=https://chat.snowcrashlabs.com
WEBUI_AUTH=true
WEBUI_AUTH_TRUSTED_EMAIL_HEADER=
WEBUI_AUTH_TRUSTED_NAME_HEADER=
WEBUI_AUTH_TRUSTED_GROUPS_HEADER=
WEBUI_AUTH_TRUSTED_ROLE_HEADER=
ENABLE_PERSISTENT_CONFIG=false
ENABLE_OAUTH_PERSISTENT_CONFIG=false
RESET_CONFIG_ON_START=false
CUSTOM_NAME=
DEFAULT_LOCALE=en-US
DEFAULT_MODELS=quorum:auto
DEFAULT_PINNED_MODELS=
MODEL_ORDER_LIST=[]
DEFAULT_INTERFACE_SETTINGS={"showChangelog":false,"showUpdateToast":false}
DEFAULT_PROMPT_SUGGESTIONS=[]
EXTERNAL_PWA_MANIFEST_URL=http://127.0.0.1:8080/static/site.webmanifest

# Exactly one OIDC provider; Keycloak handles email links and staff passwords.
ENABLE_LOGIN_FORM=false
ENABLE_PASSWORD_CHANGE_FORM=false
ENABLE_SIGNUP=false
ENABLE_INITIAL_ADMIN_SIGNUP=false
ENABLE_LDAP=false
ENABLE_OAUTH=true
ENABLE_OAUTH_SIGNUP=true
DEFAULT_USER_ROLE=user
DEFAULT_GROUP_ID=
OAUTH_PROVIDER_NAME=SnowCrash
OAUTH_AUTO_REDIRECT=false
OAUTH_CLIENT_ID=snowcrash-chat
OPENID_PROVIDER_URL=https://auth.snowcrashlabs.com/realms/snowcrash-customers/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://chat.snowcrashlabs.com/oauth/oidc/login/callback
OAUTH_CODE_CHALLENGE_METHOD=S256
OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
GITHUB_CLIENT_ID=
FEISHU_CLIENT_ID=
ENABLE_OAUTH_GROUP_MANAGEMENT=false
ENABLE_OAUTH_GROUP_CREATION=false
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
ENABLE_OAUTH_EMAIL_FALLBACK=false
ENABLE_OAUTH_ID_TOKEN_COOKIE=false
WEBUI_AUTH_COOKIE_SECURE=true
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SAME_SITE=lax
WEBUI_SESSION_COOKIE_SAME_SITE=lax

# Only the server-side SC connection. Empty model_ids means discover /v1/models.
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=http://sc:8000/v1
OPENAI_API_BASE_URLS=http://sc:8000/v1
ENABLE_OLLAMA_API=false
BYPASS_ADMIN_ACCESS_CONTROL=false
ENABLE_FORWARD_USER_INFO_HEADERS=false
ENABLE_BASE_MODELS_CACHE=false
TASK_MODEL=
TASK_MODEL_EXTERNAL=

# Prospect-safe feature switches (including server-side plugin master switch).
ENABLE_PLUGINS=false
ENABLE_TOOLS=false
ENABLE_FUNCTIONS=false
ENABLE_TOOL_SERVERS=false
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_DIRECT_INTEGRATIONS=false
ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS=false
ENABLE_EVALUATION_ARENA_MODELS=false
EVALUATION_ARENA_MODELS=[]
ENABLE_MESSAGE_RATING=false
ENABLE_IMAGE_GENERATION=false
ENABLE_IMAGE_EDIT=false
ENABLE_IMAGE_PROMPT_GENERATION=false
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
ENABLE_API_KEYS=false
ENABLE_CHANNELS=false
ENABLE_APPS=false
ENABLE_CALENDAR=false
ENABLE_AUTOMATIONS=false
ENABLE_NOTES=false
ENABLE_MEMORIES=false
ENABLE_USER_WEBHOOKS=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_VERSION_UPDATE_CHECK=false
ENABLE_EASTER_EGGS=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_TAGS_GENERATION=false
# Titles follow the selected model and SC accounting; disable if not desired.
ENABLE_TITLE_GENERATION=true

# Default permissions; administrators keep upstream administrative controls.
USER_PERMISSIONS_WORKSPACE_MODELS_ACCESS=false
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ACCESS=false
USER_PERMISSIONS_WORKSPACE_PROMPTS_ACCESS=false
USER_PERMISSIONS_WORKSPACE_TOOLS_ACCESS=false
USER_PERMISSIONS_WORKSPACE_SKILLS_ACCESS=false
USER_PERMISSIONS_WORKSPACE_MODELS_IMPORT=false
USER_PERMISSIONS_WORKSPACE_MODELS_EXPORT=false
USER_PERMISSIONS_WORKSPACE_PROMPTS_IMPORT=false
USER_PERMISSIONS_WORKSPACE_PROMPTS_EXPORT=false
USER_PERMISSIONS_WORKSPACE_TOOLS_IMPORT=false
USER_PERMISSIONS_WORKSPACE_TOOLS_EXPORT=false
USER_PERMISSIONS_WORKSPACE_SKILLS_IMPORT=false
USER_PERMISSIONS_WORKSPACE_SKILLS_EXPORT=false
USER_PERMISSIONS_CHAT_CONTROLS=false
USER_PERMISSIONS_CHAT_VALVES=false
USER_PERMISSIONS_CHAT_SYSTEM_PROMPT=false
USER_PERMISSIONS_CHAT_PARAMS=false
USER_PERMISSIONS_CHAT_WEB_UPLOAD=false
USER_PERMISSIONS_CHAT_RATE_RESPONSE=false
USER_PERMISSIONS_CHAT_SHARE=false
USER_PERMISSIONS_CHAT_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_CHAT_ALLOW_OPEN_SHARING=false
USER_PERMISSIONS_CHAT_IMPORT=false
USER_PERMISSIONS_CHAT_STT=false
USER_PERMISSIONS_CHAT_TTS=false
USER_PERMISSIONS_CHAT_CALL=false
USER_PERMISSIONS_CHAT_MULTIPLE_MODELS=false
USER_PERMISSIONS_FEATURES_DIRECT_TOOL_SERVERS=false
USER_PERMISSIONS_FEATURES_WEB_SEARCH=false
USER_PERMISSIONS_FEATURES_IMAGE_GENERATION=false
USER_PERMISSIONS_FEATURES_CODE_INTERPRETER=false
USER_PERMISSIONS_FEATURES_API_KEYS=false
USER_PERMISSIONS_FEATURES_CHANNELS=false
USER_PERMISSIONS_FEATURES_ENCRYPTED_CHANNELS=false
USER_PERMISSIONS_FEATURES_NOTES=false
USER_PERMISSIONS_FEATURES_CALENDAR=false
USER_PERMISSIONS_FEATURES_AUTOMATIONS=false
USER_PERMISSIONS_FEATURES_MEMORIES=false
USER_PERMISSIONS_FEATURES_USER_WEBHOOKS=false
USER_PERMISSIONS_SETTINGS_INTERFACE=true

SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# A: NOW -- shared SC connection, existing customers-realm login.
# Required secret env: OPENAI_API_KEY, OAUTH_CLIENT_SECRET, WEBUI_SECRET_KEY,
# OAUTH_SESSION_TOKEN_ENCRYPTION_KEY. Retain stable existing encryption keys.
# OPENAI_API_KEYS empty deliberately falls back to OPENAI_API_KEY from secret env.
OPENAI_API_KEYS=
OPENAI_API_CONFIGS={"0":{"enable":true,"auth_type":"bearer","model_ids":[],"headers":{},"forward_cookies":false}}
BYPASS_MODEL_ACCESS_CONTROL=true
OAUTH_SCOPES=openid email profile snowcrash-customer-claims
ENABLE_OAUTH_ROLE_MANAGEMENT=false
